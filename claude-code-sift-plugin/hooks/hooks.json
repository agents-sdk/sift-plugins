{
	"description": "Compress large tool outputs with sift and teach the model how to retrieve originals",
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node",
						"args": [
							"${CLAUDE_PLUGIN_ROOT}/dist/hooks/post-tool-use.js"
						],
						"timeout": 30
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node",
						"args": [
							"${CLAUDE_PLUGIN_ROOT}/dist/hooks/session-start.js"
						],
						"timeout": 10
					}
				]
			}
		]
	}
}
