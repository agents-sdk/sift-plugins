{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"outDir": "dist",
		"rootDir": "src",
		"noEmit": false
	},
	"include": ["src"]
}
